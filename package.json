{
  "name": "elite-ticketing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @elite-ticketing/api --filter @elite-ticketing/web dev",
    "build": "pnpm -r --if-present build",
    "test": "node scripts/run-tests.mjs",
    "test:api": "pnpm --filter @elite-ticketing/api test",
    "test:web": "pnpm --filter @elite-ticketing/web test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
